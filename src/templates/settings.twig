{# Field names carry no `settings[…]` prefix: `craft\base\Plugin::settingsResponse()` runs this
   template's output through `View::namespaceInputs(…, 'settings')`, so a name written as
   `settings[foo]` here posts as `settings[settings][foo]`, saves nothing, and still reports
   “Plugin settings saved”. #}
{% import '_includes/forms' as forms %}

{% set commerceReady = craft.app.plugins.isPluginEnabled('commerce') %}
{% set connection = plugin.oauth.getConnection() %}
{% set connected = plugin.oauth.isConnected() %}
{% set daysLeft = connection ? connection.getDaysUntilExpiry() : null %}

{% if not commerceReady %}
    <div class="pane">
        <p class="error">{{ 'Craft Commerce is not installed or enabled. Exactly needs it to do anything.'|t('exactly') }}</p>
    </div>
{% endif %}

{# ------------------------------------------------------------------ #}
<h2>{{ 'Connection'|t('exactly') }}</h2>

<div class="pane">
    <p>
        {{ 'Create an app at'|t('exactly') }}
        <a href="https://apps.exactonline.com" rel="noopener" target="_blank">apps.exactonline.com</a>,
        {{ 'register the redirect URI below on it, then paste its client ID and secret here and save.'|t('exactly') }}
    </p>

    {{ forms.textField({
        label: 'Redirect URI'|t('exactly'),
        instructions: 'Exact Online matches this exactly, character for character. Copy it — don’t retype it.'|t('exactly'),
        id: 'exactly-redirect',
        value: settings.getRedirectUri(),
        readonly: true,
        class: 'code'
    }) }}

    {% if not settings.redirectUriIsClean() %}
        <p class="warning" id="exactly-redirect-warning">
            {{ 'This redirect URI has a query string in it because `omitScriptNameInUrls` is off. Exact Online can refuse a redirect URI like that, which ends in a redirect_uri mismatch. Turn `omitScriptNameInUrls` on (with URL rewriting set up on the server) so it becomes a plain path, then copy it again.'|t('exactly') }}
        </p>
    {% endif %}

    <div class="field">
        {% if connected %}
            <span class="status green"></span>
            <strong>{{ 'Connected'|t('exactly') }}</strong>
            <span class="light">{{ connection.describe() }}</span>
            {% if daysLeft is not null %}
                <span class="light">
                    — {{ 'reconnect within {days} days'|t('exactly', { days: daysLeft }) }}
                </span>
            {% endif %}
        {% elseif connection %}
            <span class="status red"></span>
            <strong>{{ 'The connection has expired'|t('exactly') }}</strong>
            <span class="light">{{ 'Exact Online refresh tokens last 30 days. Connect again.'|t('exactly') }}</span>
        {% else %}
            <span class="status"></span>
            <span class="light">{{ 'Not connected yet.'|t('exactly') }}</span>
        {% endif %}
    </div>

    {% if daysLeft is not null and daysLeft < 7 and connected %}
        <p class="warning">
            {{ 'This connection expires in {days} days. Exact Online refresh tokens are single-use and last 30 days from the last call, so a store that goes quiet for a month has to reconnect by hand.'|t('exactly', { days: daysLeft }) }}
        </p>
    {% endif %}

    <div class="field">
        <a class="btn submit" href="{{ actionUrl('exactly/oauth/connect') }}">
            {{ connected ? 'Reconnect'|t('exactly') : 'Connect to Exact Online'|t('exactly') }}
        </a>
        <button type="button" class="btn" id="exactly-test">{{ 'Test connection'|t('exactly') }}</button>
        {% if connection %}
            <button type="button" class="btn" id="exactly-disconnect">{{ 'Disconnect'|t('exactly') }}</button>
        {% endif %}
        <span class="light" id="exactly-test-result"></span>
    </div>
</div>

{{ forms.selectField({
    label: 'Region'|t('exactly'),
    instructions: 'Exact Online runs a separate site per country, and an account on one cannot be reached on another.'|t('exactly'),
    id: 'region',
    name: 'region',
    options: [
        { label: 'Netherlands (start.exactonline.nl)', value: 'nl' },
        { label: 'Belgium (start.exactonline.be)', value: 'be' },
        { label: 'Germany (start.exactonline.de)', value: 'de' },
        { label: 'France (start.exactonline.fr)', value: 'fr' },
        { label: 'Spain (start.exactonline.es)', value: 'es' },
        { label: 'United Kingdom (start.exactonline.co.uk)', value: 'uk' },
        { label: 'International (start.exactonline.com)', value: 'com' }
    ],
    value: settings.region
}) }}

{{ forms.autosuggestField({
    label: 'Custom base URL'|t('exactly'),
    instructions: 'Overrides the region. Only needed for an Exact region newer than this release.'|t('exactly'),
    id: 'customBaseUrl',
    name: 'customBaseUrl',
    value: settings.customBaseUrl,
    suggestEnvVars: true,
    errors: settings.getErrors('customBaseUrl')
}) }}

{{ forms.autosuggestField({
    label: 'Client ID'|t('exactly'),
    id: 'clientId',
    name: 'clientId',
    value: settings.clientId,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: 'Client secret'|t('exactly'),
    id: 'clientSecret',
    name: 'clientSecret',
    value: settings.clientSecret,
    suggestEnvVars: true,
    warning: settings.clientSecret and settings.clientSecret|first != '$'
        ? 'Saved like this, the secret is written to project config and committed with it. Use an environment variable, such as $EXACT_CLIENT_SECRET.'|t('exactly')
        : null
}) }}

{{ forms.textField({
    label: 'Division'|t('exactly'),
    instructions: 'The administration invoices are written into. Leave at 0 to use whichever division the connected user is in.'|t('exactly'),
    id: 'division',
    name: 'division',
    type: 'number',
    value: settings.division
}) }}

<div class="field">
    <button type="button" class="btn" id="exactly-divisions">{{ 'List administrations'|t('exactly') }}</button>
    <span class="light" id="exactly-divisions-result"></span>
</div>

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'Invoicing'|t('exactly') }}</h2>

{{ forms.selectField({
    label: 'When to invoice'|t('exactly'),
    instructions: 'Everything but “Only when I ask” goes through the queue, so an Exact Online outage can never hold up a checkout.'|t('exactly'),
    id: 'pushTrigger',
    name: 'pushTrigger',
    options: [
        { label: 'Only when I ask'|t('exactly'), value: 'manual' },
        { label: 'As soon as the order completes'|t('exactly'), value: 'completed' },
        { label: 'When the order is fully paid'|t('exactly'), value: 'paid' },
        { label: 'When the order reaches a status'|t('exactly'), value: 'status' }
    ],
    value: settings.pushTrigger
}) }}

{% set statusList = [] %}
{% if commerceReady %}
    {% for status in craft.commerce.orderStatuses.getAllOrderStatuses() %}
        {% set statusList = statusList|merge([{ label: status.name, value: status.handle }]) %}
    {% endfor %}
{% endif %}

{{ forms.checkboxSelectField({
    label: 'Trigger statuses'|t('exactly'),
    instructions: 'Used when the trigger above is “When the order reaches a status”.'|t('exactly'),
    id: 'triggerStatusHandles',
    name: 'triggerStatusHandles',
    options: statusList,
    values: settings.triggerStatusHandles
}) }}

{{ forms.textField({
    label: 'Sales journal'|t('exactly'),
    instructions: 'The Exact journal code sales invoices are booked to. `70` is Exact’s default sales journal.'|t('exactly'),
    id: 'journalCode',
    name: 'journalCode',
    value: settings.journalCode
}) }}

{{ forms.selectField({
    label: 'Invoice date'|t('exactly'),
    id: 'invoiceDateSource',
    name: 'invoiceDateSource',
    options: [
        { label: 'The date the order was placed'|t('exactly'), value: 'orderDate' },
        { label: 'The date the order was paid'|t('exactly'), value: 'paidDate' },
        { label: 'Today'|t('exactly'), value: 'today' }
    ],
    value: settings.invoiceDateSource
}) }}

{{ forms.selectField({
    label: 'Your reference'|t('exactly'),
    instructions: 'Which Craft order identifier goes on the invoice as the customer reference.'|t('exactly'),
    id: 'orderNumberSource',
    name: 'orderNumberSource',
    options: [
        { label: 'Order reference'|t('exactly'), value: 'reference' },
        { label: 'Order number'|t('exactly'), value: 'number' },
        { label: 'Short order number'|t('exactly'), value: 'shortNumber' },
        { label: 'Order ID'|t('exactly'), value: 'id' }
    ],
    value: settings.orderNumberSource
}) }}

{{ forms.textField({
    label: 'Invoice description'|t('exactly'),
    instructions: 'An object template, rendered against the order.'|t('exactly'),
    id: 'descriptionTemplate',
    name: 'descriptionTemplate',
    value: settings.descriptionTemplate,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Line description'|t('exactly'),
    instructions: 'An object template, rendered against each line item. Leave blank to use Commerce’s own description.'|t('exactly'),
    id: 'lineDescriptionTemplate',
    name: 'lineDescriptionTemplate',
    value: settings.lineDescriptionTemplate,
    class: 'code'
}) }}

{{ forms.textareaField({
    label: 'Remarks'|t('exactly'),
    instructions: 'An object template, rendered against the order, placed in the invoice’s remarks field.'|t('exactly'),
    id: 'remarksTemplate',
    name: 'remarksTemplate',
    value: settings.remarksTemplate,
    rows: 2,
    class: 'code'
}) }}

{{ forms.lightswitchField({
    label: 'Add a shipping line'|t('exactly'),
    id: 'includeShippingLine',
    name: 'includeShippingLine',
    on: settings.includeShippingLine
}) }}

{{ forms.lightswitchField({
    label: 'Add a discount line'|t('exactly'),
    instructions: 'Order-level and line-level discounts, on one line. Line prices never include them, so nothing is counted twice.'|t('exactly'),
    id: 'includeDiscountLine',
    name: 'includeDiscountLine',
    on: settings.includeDiscountLine
}) }}

{{ forms.textField({
    label: 'Rounding tolerance'|t('exactly'),
    instructions: 'Exact recomputes VAT from the line amounts, so its total can land a cent or two from what the customer paid. A difference this size or smaller is corrected with a rounding line; anything bigger stops the push instead of quietly booking a wrong total. Set to 0 to switch the whole check off.'|t('exactly'),
    id: 'roundingTolerance',
    name: 'roundingTolerance',
    type: 'number',
    step: '0.01',
    value: settings.roundingTolerance,
    errors: settings.getErrors('roundingTolerance')
}) }}

{{ forms.textField({
    label: 'Payment condition'|t('exactly'),
    instructions: 'Exact payment-terms code. Blank uses the account’s own.'|t('exactly'),
    id: 'paymentConditionCode',
    name: 'paymentConditionCode',
    value: settings.paymentConditionCode
}) }}

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'Customers'|t('exactly') }}</h2>

{{ forms.selectField({
    label: 'Match customers by'|t('exactly'),
    instructions: 'How an order’s customer is found in Exact before a new account is considered.'|t('exactly'),
    id: 'accountMatchStrategy',
    name: 'accountMatchStrategy',
    options: [
        { label: 'Email, then VAT number'|t('exactly'), value: 'emailThenVat' },
        { label: 'VAT number, then email'|t('exactly'), value: 'vatThenEmail' },
        { label: 'Email only'|t('exactly'), value: 'email' },
        { label: 'VAT number only'|t('exactly'), value: 'vat' }
    ],
    value: settings.accountMatchStrategy
}) }}

{{ forms.lightswitchField({
    label: 'Create missing accounts'|t('exactly'),
    instructions: 'With this off, an order whose customer is not already in Exact fails rather than inventing one.'|t('exactly'),
    id: 'createMissingAccounts',
    name: 'createMissingAccounts',
    on: settings.createMissingAccounts
}) }}

{{ forms.lightswitchField({
    label: 'Update existing accounts'|t('exactly'),
    instructions: 'Keep an Exact account’s address in step with the order’s. Off by default — a bookkeeper’s corrections should outlive a checkout.'|t('exactly'),
    id: 'updateExistingAccounts',
    name: 'updateExistingAccounts',
    on: settings.updateExistingAccounts
}) }}

{{ forms.selectField({
    label: 'Account status'|t('exactly'),
    id: 'accountStatus',
    name: 'accountStatus',
    options: [
        { label: 'Customer'|t('exactly'), value: 'C' },
        { label: 'Prospect'|t('exactly'), value: 'P' },
        { label: 'Suspect'|t('exactly'), value: 'S' },
        { label: 'None'|t('exactly'), value: 'A' }
    ],
    value: settings.accountStatus
}) }}

{{ forms.textField({
    label: 'VAT number field'|t('exactly'),
    instructions: 'Handle of the field holding the customer’s VAT number. Craft 5 addresses have an “Organization Tax ID” attribute, which Exactly reads automatically — this is only needed if your store keeps the number somewhere else.'|t('exactly'),
    id: 'vatNumberFieldHandle',
    name: 'vatNumberFieldHandle',
    value: settings.vatNumberFieldHandle,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Company name field'|t('exactly'),
    instructions: 'Optional. Falls back to the address’s organization, then its name.'|t('exactly'),
    id: 'companyFieldHandle',
    name: 'companyFieldHandle',
    value: settings.companyFieldHandle,
    class: 'code'
}) }}

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'Items and ledger'|t('exactly') }}</h2>

<div class="pane">
    <p>
        {{ 'Exact Online requires an item on every sales invoice line — there is no “description only” line. Most stores put everything on one generic item and carry the product name in the line description; a Commerce catalogue of thousands of variants does not belong in an accounting package’s stock list.'|t('exactly') }}
    </p>
</div>

{{ forms.selectField({
    label: 'Item matching'|t('exactly'),
    id: 'itemStrategy',
    name: 'itemStrategy',
    options: [
        { label: 'Match the SKU, fall back to a generic item'|t('exactly'), value: 'sku' },
        { label: 'Always use the generic item'|t('exactly'), value: 'fallback' }
    ],
    value: settings.itemStrategy
}) }}

{{ forms.textField({
    label: 'Fallback item code'|t('exactly'),
    instructions: 'The Exact item code (or ID) every unmatched line is invoiced against. Without one, an unmatched SKU fails the push.'|t('exactly'),
    id: 'fallbackItemCode',
    name: 'fallbackItemCode',
    value: settings.fallbackItemCode,
    class: 'code'
}) }}

{{ forms.lightswitchField({
    label: 'Create missing items'|t('exactly'),
    id: 'createMissingItems',
    name: 'createMissingItems',
    on: settings.createMissingItems
}) }}

{{ forms.textField({
    label: 'Default revenue GL account'|t('exactly'),
    instructions: 'Ledger code for invoice lines. Blank lets Exact use each item’s own revenue account.'|t('exactly'),
    id: 'defaultGlAccountCode',
    name: 'defaultGlAccountCode',
    value: settings.defaultGlAccountCode,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Shipping item code'|t('exactly'),
    id: 'shippingItemCode',
    name: 'shippingItemCode',
    value: settings.shippingItemCode,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Shipping GL account'|t('exactly'),
    id: 'shippingGlAccountCode',
    name: 'shippingGlAccountCode',
    value: settings.shippingGlAccountCode,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Discount item code'|t('exactly'),
    id: 'discountItemCode',
    name: 'discountItemCode',
    value: settings.discountItemCode,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Discount GL account'|t('exactly'),
    id: 'discountGlAccountCode',
    name: 'discountGlAccountCode',
    value: settings.discountGlAccountCode,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Rounding item code'|t('exactly'),
    id: 'roundingItemCode',
    name: 'roundingItemCode',
    value: settings.roundingItemCode,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Rounding GL account'|t('exactly'),
    id: 'roundingGlAccountCode',
    name: 'roundingGlAccountCode',
    value: settings.roundingGlAccountCode,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Rounding VAT code'|t('exactly'),
    instructions: 'Must be a 0% code. A rounding line that attracts VAT moves the total by the difference plus VAT, and never lands on the right number.'|t('exactly'),
    id: 'roundingVatCode',
    name: 'roundingVatCode',
    value: settings.roundingVatCode,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Cost centre'|t('exactly'),
    id: 'costCenterCode',
    name: 'costCenterCode',
    value: settings.costCenterCode,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Cost unit'|t('exactly'),
    id: 'costUnitCode',
    name: 'costUnitCode',
    value: settings.costUnitCode,
    class: 'code'
}) }}

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'VAT'|t('exactly') }}</h2>

<div class="pane">
    <p>
        {{ 'Exactly works out how each sale should be treated from the shipping country and the customer’s VAT number, then uses the code you map here. Map every one of them: an unmapped treatment means Exact falls back to the item’s own VAT code, which is right for domestic sales and wrong for everything else.'|t('exactly') }}
    </p>

    {% set unmapped = settings.getUnmappedTreatments() %}
    {% if unmapped|length %}
        <p class="warning">
            {{ 'Not mapped yet: {list}'|t('exactly', { list: unmapped|join(', ') }) }}
        </p>
    {% endif %}
</div>

{{ forms.textField({
    label: 'Seller country'|t('exactly'),
    instructions: 'ISO country code the administration invoices from. Blank reads it from Exact.'|t('exactly'),
    id: 'sellerCountry',
    name: 'sellerCountry',
    value: settings.sellerCountry,
    size: 4,
    errors: settings.getErrors('sellerCountry')
}) }}

{% set treatmentRows = {
    'domestic': 'Domestic — the buyer is in the same country as the administration'|t('exactly'),
    'reverse-charge': 'Intra-community reverse charge — EU business with a valid VAT number'|t('exactly'),
    'oss': 'EU consumer (OSS) — destination VAT, reported through One Stop Shop'|t('exactly'),
    'export': 'Export — outside the EU'|t('exactly'),
    'exempt': 'Exempt'|t('exactly')
} %}

{% for treatment, label in treatmentRows %}
    {{ forms.textField({
        label: label,
        id: 'vatCodeByTreatment-' ~ treatment,
        name: 'vatCodeByTreatment[' ~ treatment ~ ']',
        value: settings.vatCodeByTreatment[treatment] ?? '',
        placeholder: 'Exact VAT code'|t('exactly'),
        class: 'code',
        size: 12
    }) }}
{% endfor %}

{% set taxCategoryOptions = plugin.vat.getCommerceTaxCategoryOptions() %}
{% if taxCategoryOptions|length %}
    {{ forms.checkboxSelectField({
        label: 'VAT-exempt tax categories'|t('exactly'),
        instructions: 'A line in one of these Commerce tax categories that was charged no tax is invoiced with the Exempt code above, whatever the order’s treatment. A line that was charged tax keeps the code for what it was charged.'|t('exactly'),
        id: 'exemptTaxCategoryIds',
        name: 'exemptTaxCategoryIds',
        options: taxCategoryOptions,
        values: settings.getExemptTaxCategoryIds()|map(id => id ~ '')
    }) }}
{% endif %}

{% set taxRates = plugin.vat.getCommerceTaxRates() %}
{% if taxRates|length %}
    <h3>{{ 'Per Commerce tax rate'|t('exactly') }}</h3>
    <p class="light">
        {{ 'When a line actually carries one of these rates, its code wins over the treatment above — a merchant who has modelled reduced rates in Commerce knows better than any inference.'|t('exactly') }}
    </p>

    {% for rate in taxRates %}
        {{ forms.textField({
            label: rate.name ~ ' (' ~ (rate.rate * 100)|number_format(2) ~ '%)',
            id: 'vatCodeByTaxRate-' ~ rate.id,
            name: 'vatCodeByTaxRate[' ~ rate.id ~ ']',
            value: settings.vatCodeByTaxRate[rate.id] ?? '',
            placeholder: 'Exact VAT code'|t('exactly'),
            class: 'code',
            size: 12
        }) }}
    {% endfor %}
{% endif %}

{{ forms.lightswitchField({
    label: 'Reverse charge needs a well-formed VAT number'|t('exactly'),
    instructions: 'With this off, any non-empty value in the VAT field is enough to zero-rate the sale.'|t('exactly'),
    id: 'requireValidVatNumber',
    name: 'requireValidVatNumber',
    on: settings.requireValidVatNumber
}) }}

{{ forms.lightswitchField({
    label: 'Check VAT numbers against VIES'|t('exactly'),
    instructions: 'Fails closed: a number VIES will not confirm is treated as a consumer sale, which charges VAT. Over-charging is recoverable; under-charging is your liability.'|t('exactly'),
    id: 'viesValidation',
    name: 'viesValidation',
    on: settings.viesValidation
}) }}

<div class="field">
    <input type="text" class="text code" id="exactly-vat-test" size="20" placeholder="NL123456789B01">
    <button type="button" class="btn" id="exactly-vat-check">{{ 'Check with VIES'|t('exactly') }}</button>
    <span class="light" id="exactly-vat-result"></span>
</div>

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'Delivery'|t('exactly') }}</h2>

{{ forms.selectField({
    label: 'Send the invoice'|t('exactly'),
    instructions: 'Peppol is what EU e-invoicing mandates want; the postbox needs an Exact Mailbox licence.'|t('exactly'),
    id: 'deliveryMode',
    name: 'deliveryMode',
    options: [
        { label: 'Don’t — leave it for me to print'|t('exactly'), value: 'none' },
        { label: 'However the Exact account is set up'|t('exactly'), value: 'account' },
        { label: 'Email the PDF to the customer'|t('exactly'), value: 'email' },
        { label: 'Exact digital postbox'|t('exactly'), value: 'postbox' },
        { label: 'Peppol network'|t('exactly'), value: 'peppol' }
    ],
    value: settings.deliveryMode
}) }}

{{ forms.textField({
    label: 'Document layout ID'|t('exactly'),
    instructions: 'An Exact layout ID (a GUID), not a name.'|t('exactly'),
    id: 'documentLayoutId',
    name: 'documentLayoutId',
    value: settings.documentLayoutId,
    class: 'code',
    errors: settings.getErrors('documentLayoutId')
}) }}

{{ forms.textField({
    label: 'Email layout ID'|t('exactly'),
    id: 'emailLayoutId',
    name: 'emailLayoutId',
    value: settings.emailLayoutId,
    class: 'code',
    errors: settings.getErrors('emailLayoutId')
}) }}

{{ forms.autosuggestField({
    label: 'Sender email address'|t('exactly'),
    id: 'senderEmailAddress',
    name: 'senderEmailAddress',
    value: settings.senderEmailAddress,
    suggestEnvVars: true,
    errors: settings.getErrors('senderEmailAddress')
}) }}

{{ forms.textareaField({
    label: 'Extra text'|t('exactly'),
    id: 'extraText',
    name: 'extraText',
    value: settings.extraText,
    rows: 2
}) }}

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'Automation'|t('exactly') }}</h2>

{{ forms.lightswitchField({
    label: 'Push through the queue'|t('exactly'),
    instructions: 'Strongly recommended. An Exact Online outage must never be able to stop a customer checking out.'|t('exactly'),
    id: 'useQueue',
    name: 'useQueue',
    on: settings.useQueue
}) }}

{{ forms.textField({
    label: 'Maximum attempts'|t('exactly'),
    id: 'maxAttempts',
    name: 'maxAttempts',
    type: 'number',
    value: settings.maxAttempts,
    errors: settings.getErrors('maxAttempts')
}) }}

{{ forms.textField({
    label: 'Retry delay (minutes)'|t('exactly'),
    instructions: 'How long a failed push waits before maintenance, `exactly/sync/retry` or Retry failures picks it up again. 0 retries on the next run.'|t('exactly'),
    id: 'retryDelayMinutes',
    name: 'retryDelayMinutes',
    type: 'number',
    value: settings.retryDelayMinutes,
    errors: settings.getErrors('retryDelayMinutes')
}) }}

{{ forms.lightswitchField({
    label: 'Credit notes on refund'|t('exactly'),
    instructions: 'When an invoiced order is refunded in full, queue a credit note for it. A partial refund issues nothing — a credit note reverses the whole invoice — and is noted in the log instead.'|t('exactly'),
    id: 'creditNotesOnRefund',
    name: 'creditNotesOnRefund',
    on: settings.creditNotesOnRefund
}) }}

{{ forms.selectField({
    label: 'Credit note amounts'|t('exactly'),
    instructions: 'Exact’s field reference does not state which sign credit-note lines take, so this is a switch rather than an assumption. If credit notes come out doubling the invoice instead of cancelling it, change this.'|t('exactly'),
    id: 'creditNoteSign',
    name: 'creditNoteSign',
    options: [
        { label: 'Positive'|t('exactly'), value: 'positive' },
        { label: 'Negative'|t('exactly'), value: 'negative' }
    ],
    value: settings.creditNoteSign
}) }}

{{ forms.lightswitchField({
    label: 'Read payment status back from Exact'|t('exactly'),
    instructions: 'Reconciles against Exact’s open items. Run `exactly/sync/payments` on a schedule.'|t('exactly'),
    id: 'paymentWriteback',
    name: 'paymentWriteback',
    on: settings.paymentWriteback
}) }}

{{ forms.selectField({
    label: 'Paid order status'|t('exactly'),
    instructions: 'Where an order goes when Exact reports its invoice paid. Blank records the payment on the document only.'|t('exactly'),
    id: 'paidStatusHandle',
    name: 'paidStatusHandle',
    options: [{ label: 'Leave the order alone'|t('exactly'), value: '' }]|merge(statusList),
    value: settings.paidStatusHandle
}) }}

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'Payment entries'|t('exactly') }}</h2>

<div class="pane">
    <p>
        {{ 'Enter every successful Commerce payment in Exact as a bank or cash entry line, matched to its invoice by customer and invoice number — and each refund matched to its credit note. Exact then shows the invoice as settled, and nobody has to match a Stripe or Mollie payout by hand. A payment waits until its invoice is processed in Exact: a draft invoice is not an open item, so there is nothing to match yet.'|t('exactly') }}
    </p>
</div>

{{ forms.lightswitchField({
    label: 'Enter payments in Exact'|t('exactly'),
    instructions: 'Queued from every successful capture, purchase or refund; never on the checkout itself. Run `exactly/sync/maintenance` on a schedule to pick up payments waiting for their invoice.'|t('exactly'),
    id: 'registerPayments',
    name: 'registerPayments',
    on: settings.registerPayments,
    toggle: 'exactly-payment-entries'
}) }}

<div id="exactly-payment-entries" class="{{ settings.registerPayments ? '' : 'hidden' }}">
    {{ forms.selectField({
        label: 'Entry type'|t('exactly'),
        instructions: 'Bank entries also cover payment-service journals, which is what a Stripe, Mollie or PayPal clearing journal usually is in Exact.'|t('exactly'),
        id: 'paymentEntryType',
        name: 'paymentEntryType',
        options: [
            { label: 'Bank entry'|t('exactly'), value: 'bank' },
            { label: 'Cash entry'|t('exactly'), value: 'cash' }
        ],
        value: settings.paymentEntryType
    }) }}

    {{ forms.textField({
        label: 'Payment journal'|t('exactly'),
        instructions: 'The Exact journal code payments are entered in, for any gateway without its own below.'|t('exactly'),
        id: 'paymentJournalCode',
        name: 'paymentJournalCode',
        value: settings.paymentJournalCode,
        class: 'code',
        size: 12,
        errors: settings.getErrors('paymentJournalCode')
    }) }}

    {% set gateways = commerceReady ? craft.commerce.gateways.getAllGateways() : [] %}
    {% if gateways|length %}
        <h3>{{ 'Journal per gateway'|t('exactly') }}</h3>
        <p class="light">{{ 'Optional. Stripe pays out to one clearing journal, PayPal holds a balance of its own; a journal per gateway keeps each one reconcilable against its own statement.'|t('exactly') }}</p>
        {% for gateway in gateways %}
            {{ forms.textField({
                label: gateway.name,
                id: 'paymentJournalByGateway-' ~ gateway.handle,
                name: 'paymentJournalByGateway[' ~ gateway.handle ~ ']',
                value: settings.paymentJournalByGateway[gateway.handle] ?? '',
                placeholder: 'Journal code'|t('exactly'),
                class: 'code',
                size: 12
            }) }}
        {% endfor %}
    {% endif %}

    {{ forms.textField({
        label: 'Receivables GL account'|t('exactly'),
        instructions: 'The debtors control account the payment line is booked on — 1300 in most Dutch charts. Exact needs a ledger account on every entry line.'|t('exactly'),
        id: 'paymentReceivablesGlAccountCode',
        name: 'paymentReceivablesGlAccountCode',
        value: settings.paymentReceivablesGlAccountCode,
        class: 'code',
        size: 12,
        errors: settings.getErrors('paymentReceivablesGlAccountCode')
    }) }}

    {{ forms.selectField({
        label: 'Money received is'|t('exactly'),
        instructions: 'Exact’s reference only says that the opening balance plus the lines makes the closing balance, which reads as “money in is positive”. If payments come out doubling the receivable instead of settling it, change this. Refunds and fees always take the opposite sign.'|t('exactly'),
        id: 'paymentAmountSign',
        name: 'paymentAmountSign',
        options: [
            { label: 'Positive'|t('exactly'), value: 'positive' },
            { label: 'Negative'|t('exactly'), value: 'negative' }
        ],
        value: settings.paymentAmountSign
    }) }}

    {{ forms.lightswitchField({
        label: 'Enter refunds too'|t('exactly'),
        instructions: 'Matched to the order’s credit note. A refund with no credit note to match — a partial refund, or credit notes switched off — is skipped with the reason, for you to book.'|t('exactly'),
        id: 'registerRefunds',
        name: 'registerRefunds',
        on: settings.registerRefunds
    }) }}

    {{ forms.lightswitchField({
        label: 'Book processor fees'|t('exactly'),
        instructions: 'Adds the fee Stripe or PayPal kept as a second line on the same entry, so it nets to what reached the bank. Read from the gateway’s stored response; a payment whose response does not carry the fee is entered without one. Leave off if you already book fees from the payout report.'|t('exactly'),
        id: 'recordProcessorFees',
        name: 'recordProcessorFees',
        on: settings.recordProcessorFees
    }) }}

    {{ forms.textField({
        label: 'Fee GL account'|t('exactly'),
        instructions: 'Ledger code for bank and payment-processor charges.'|t('exactly'),
        id: 'paymentFeeGlAccountCode',
        name: 'paymentFeeGlAccountCode',
        value: settings.paymentFeeGlAccountCode,
        class: 'code',
        size: 12,
        errors: settings.getErrors('paymentFeeGlAccountCode')
    }) }}
</div>

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'Alerts'|t('exactly') }}</h2>

<p class="light">{{ 'One message when something goes wrong, one when it has cleared — never one per failure. Checked after every push, the moment Exact refuses the connection, and by `php craft exactly/alerts/check` and `exactly/sync/maintenance`.'|t('exactly') }}</p>

{{ forms.autosuggestField({
    label: 'Email alerts to'|t('exactly'),
    instructions: 'Addresses separated by commas, or an environment variable. Leave empty for no email.'|t('exactly'),
    id: 'alertRecipients',
    name: 'alertRecipients',
    suggestEnvVars: true,
    value: settings.alertRecipients,
    errors: settings.getErrors('alertRecipients')
}) }}

{{ forms.autosuggestField({
    label: 'Slack or Teams webhook URL'|t('exactly'),
    instructions: 'Optional. An incoming-webhook URL — best kept in an environment variable, because the URL is the credential. Only public hosts are allowed and redirects are never followed.'|t('exactly'),
    id: 'alertWebhookUrl',
    name: 'alertWebhookUrl',
    suggestEnvVars: true,
    value: settings.alertWebhookUrl,
    errors: settings.getErrors('alertWebhookUrl')
}) }}

{{ forms.selectField({
    label: 'Webhook format'|t('exactly'),
    id: 'alertWebhookFormat',
    name: 'alertWebhookFormat',
    options: [
        { value: 'slack', label: 'Slack'|t('exactly') },
        { value: 'teams', label: 'Microsoft Teams'|t('exactly') },
        { value: 'json', label: 'Plain JSON (your own receiver)'|t('exactly') },
    ],
    value: settings.alertWebhookFormat,
    errors: settings.getErrors('alertWebhookFormat')
}) }}

{{ forms.autosuggestField({
    label: 'Webhook signing secret'|t('exactly'),
    instructions: 'Optional. When set, each webhook carries `X-Exactly-Timestamp` and `X-Exactly-Signature: sha256=…`, an HMAC of `timestamp.body`, so your own receiver can verify it. Slack and Teams ignore it.'|t('exactly'),
    id: 'alertWebhookSecret',
    name: 'alertWebhookSecret',
    suggestEnvVars: true,
    value: settings.alertWebhookSecret
}) }}

{{ forms.lightswitchField({
    label: 'Alert when orders fail to reach Exact'|t('exactly'),
    instructions: 'Invoices, credit notes or payment entries Exact refused, or Exactly refused to send because the total did not reconcile.'|t('exactly'),
    id: 'alertOnFailures',
    name: 'alertOnFailures',
    on: settings.alertOnFailures,
    toggle: 'exactly-alert-failures'
}) }}

<div id="exactly-alert-failures" class="{{ settings.alertOnFailures ? '' : 'hidden' }}">
    {{ forms.textField({
        label: 'Failures that open an alert'|t('exactly'),
        instructions: 'This many failures inside the window below. It closes again after a whole window with none.'|t('exactly'),
        id: 'alertFailureThreshold',
        name: 'alertFailureThreshold',
        type: 'number',
        size: 5,
        value: settings.alertFailureThreshold,
        errors: settings.getErrors('alertFailureThreshold')
    }) }}

    {{ forms.textField({
        label: 'Window'|t('exactly'),
        instructions: 'Minutes. Failures are counted inside it; the incident clears after a whole window with nothing new.'|t('exactly'),
        id: 'alertWindowMinutes',
        name: 'alertWindowMinutes',
        type: 'number',
        size: 5,
        value: settings.alertWindowMinutes,
        errors: settings.getErrors('alertWindowMinutes')
    }) }}
</div>

{{ forms.lightswitchField({
    label: 'Alert when invoicing stalls'|t('exactly'),
    instructions: 'Documents or payments sitting in the queue, or — with an automatic trigger — recent orders with no invoice at all, past the age below. Usually means the queue is not running.'|t('exactly'),
    id: 'alertOnStall',
    name: 'alertOnStall',
    on: settings.alertOnStall,
    toggle: 'exactly-alert-stall'
}) }}

<div id="exactly-alert-stall" class="{{ settings.alertOnStall ? '' : 'hidden' }}">
    {{ forms.textField({
        label: 'Stalled after'|t('exactly'),
        instructions: 'Hours.'|t('exactly'),
        id: 'alertStallHours',
        name: 'alertStallHours',
        type: 'number',
        size: 5,
        value: settings.alertStallHours,
        errors: settings.getErrors('alertStallHours')
    }) }}
</div>

{{ forms.lightswitchField({
    label: 'Alert when Exact refuses the connection'|t('exactly'),
    instructions: 'A refused refresh token, a 401 that refreshing did not fix, or a connection that expired unused. Nothing is invoiced until somebody reconnects.'|t('exactly'),
    id: 'alertOnAuthFailure',
    name: 'alertOnAuthFailure',
    on: settings.alertOnAuthFailure
}) }}

{{ forms.textField({
    label: 'Quiet period after a recovery'|t('exactly'),
    instructions: 'Minutes. An incident that comes straight back is reported when this ends, if it is still happening — so a flapping connection cannot fill an inbox.'|t('exactly'),
    id: 'alertCooldownMinutes',
    name: 'alertCooldownMinutes',
    type: 'number',
    size: 5,
    value: settings.alertCooldownMinutes,
    errors: settings.getErrors('alertCooldownMinutes')
}) }}

{% if currentUser and currentUser.admin %}
    <div class="field">
        <button type="button" class="btn" id="exactly-test-alert">{{ 'Send a test alert'|t('exactly') }}</button>
        <span id="exactly-test-alert-note" class="light">{{ 'Uses the saved settings — save first.'|t('exactly') }}</span>
    </div>
{% endif %}

